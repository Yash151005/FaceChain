# ─── FaceChain Environment Configuration ───────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# SerpAPI key for Google Lens reverse image search
# Get yours at: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_api_key_here

# Alchemy RPC URL for Polygon Amoy Testnet
# Create a free app at: https://dashboard.alchemy.com/
# Select "Polygon Amoy" network, then copy the HTTPS URL
ALCHEMY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_api_key_here

# Your wallet private key (hex, with or without 0x prefix)
# Export from MetaMask: Account Details → Export Private Key
# ⚠️  NEVER share this key or commit it to Git!
PRIVATE_KEY=your_wallet_private_key_here

# Deployed FaceRecord smart contract address on Polygon Amoy
# Run `python deploy_contract.py` to deploy, then paste the address here
CONTRACT_ADDRESS=deployed_contract_address_here
